<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Weaver"
      Manufacturer="Scryer Media"
      Version="$(var.ProductVersion)"
      UpgradeCode="$(var.UpgradeCode)"
      Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Weaver is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="WeaverIcon" SourceFile="$(var.StageDir)\weaver.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ScryerMediaFolder" Name="Scryer Media">
        <Directory Id="INSTALLFOLDER" Name="Weaver">
          <Component Id="ApplicationFiles" Guid="$(var.ApplicationFilesComponentGuid)" Bitness="always64">
            <File Id="WeaverExe" Source="$(var.StageDir)\weaver.exe" KeyPath="yes" />
            <File Id="WeaverTrayExe" Source="$(var.StageDir)\weaver-tray.exe" />
            <File Id="LicenseFile" Source="$(var.StageDir)\LICENSE" />
            <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="WeaverStartMenuFolder" Name="Weaver">
        <Component Id="StartMenuShortcuts" Guid="$(var.StartMenuShortcutsComponentGuid)" Bitness="always64">
          <Shortcut
              Id="WeaverTrayShortcut"
              Name="Weaver"
              Description="Open Weaver"
              Target="[#WeaverTrayExe]"
              Icon="WeaverIcon"
              IconIndex="0"
              WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveWeaverStartMenuFolder" On="uninstall" />
          <RegistryValue
              Root="HKLM"
              Key="Software\Scryer Media\Weaver"
              Name="StartMenuShortcut"
              Type="integer"
              Value="1"
              KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Weaver" Level="1">
      <ComponentRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcuts" />
    </Feature>

    <!-- Interactive installs start the user-session tray. Silent MSI and WinGet installs
         have UILevel < 4, so they never launch a process or a browser. -->
    <CustomAction
        Id="LaunchTrayAfterInteractiveInstall"
        FileRef="WeaverTrayExe"
        ExeCommand=""
        Execute="immediate"
        Return="asyncNoWait"
        Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="LaunchTrayAfterInteractiveInstall"
              After="InstallFinalize"
              Condition="NOT Installed AND UILevel &gt;= 4" />
    </InstallExecuteSequence>

    <!-- A major upgrade removes the old product only after the new package's InstallValidate
         has checked for files in use. With the old tray (and the server it supervises) still
         running, that check raises the "applications should be closed" prompt from a hidden
         msiexec window, so the in-app and MSI upgrades look frozen, and a silent upgrade
         leaves the old binaries running. The old product's own StopTrayBeforeRemoval runs too
         late to help, so locate the installed tray and ask it to shut down before validation.
         The tray's shutdown command returns success when no tray is running.

         That command is the installed product's code, not this package's, and in releases
         that predate its stop-by-name sweep it stops only the tray of the session the
         installer runs in and the server that tray started: an orphaned server, or a tray in
         another session, survives it.
         So a second step, which runs no Weaver code, force-stops the weaver.exe and
         weaver-tray.exe processes that are still running once the graceful request has had
         its chance. It is scoped to executables inside the installed folder (the folder of
         INSTALLEDTRAYEXE), so a portable or development copy running elsewhere survives; a
         process whose path cannot be read (another user's) is skipped and left to Restart
         Manager. The folder is read into a variable outside the script block because MSI
         formatting strips braces around a resolved property. There is no tree kill: the
         upgrade helper that may have started this install is a child of weaver.exe, runs as
         weaver-upgrade-helper.exe, which is not in the name list, and must outlive the server.
         Both steps run before InstallValidate, which precedes InstallInitialize, so they are
         immediate actions and run at every UI level, /passive and /qn included. The stop's
         result is ignored. -->
    <Property Id="INSTALLEDTRAYEXE">
      <DirectorySearch Id="InstalledWeaverFolder" Path="[ProgramFiles64Folder]Scryer Media\Weaver">
        <FileSearch Id="InstalledWeaverTrayExe" Name="weaver-tray.exe" />
      </DirectorySearch>
    </Property>
    <CustomAction
        Id="StopInstalledTrayBeforeValidate"
        Property="INSTALLEDTRAYEXE"
        ExeCommand="--shutdown"
        Execute="immediate"
        Return="ignore"
        Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="StopInstalledTrayBeforeValidate"
              Before="InstallValidate"
              Condition="WIX_UPGRADE_DETECTED AND INSTALLEDTRAYEXE" />
    </InstallExecuteSequence>
    <SetProperty
        Id="STOPLEFTOVERWEAVERPOWERSHELLEXE"
        Value="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
        Before="StopLeftoverWeaverProcessesBeforeValidate"
        Sequence="execute"
        Condition="WIX_UPGRADE_DETECTED AND INSTALLEDTRAYEXE" />
    <CustomAction
        Id="StopLeftoverWeaverProcessesBeforeValidate"
        Property="STOPLEFTOVERWEAVERPOWERSHELLEXE"
        ExeCommand="-NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -Command &quot;$folder = (Split-Path -Parent '[INSTALLEDTRAYEXE]') + '\'; Get-Process weaver,weaver-tray -ErrorAction SilentlyContinue | Where-Object { $_.Path -and $_.Path.StartsWith($folder, 'OrdinalIgnoreCase') } | Stop-Process -Force&quot;"
        Execute="immediate"
        Return="ignore"
        Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="StopLeftoverWeaverProcessesBeforeValidate"
              After="StopInstalledTrayBeforeValidate"
              Condition="WIX_UPGRADE_DETECTED AND INSTALLEDTRAYEXE AND STOPLEFTOVERWEAVERPOWERSHELLEXE" />
    </InstallExecuteSequence>

    <!-- These commands affect only the uninstalling user: their HKCU Run entry, the
         tray process they own, and their Weaver profile. A major upgrade removes the old
         product as part of installing the new one; UPGRADINGPRODUCTCODE is set only in that
         removal, so the startup preference and the profile both survive an upgrade and are
         cleared only by a real uninstall. The Run entry points at the install path, which
         the upgrade keeps. -->
    <CustomAction
        Id="StopTrayBeforeRemoval"
        FileRef="WeaverTrayExe"
        ExeCommand="--shutdown"
        Execute="immediate"
        Return="check"
        Impersonate="yes" />
    <CustomAction
        Id="RemoveTrayStartupBeforeRemoval"
        FileRef="WeaverTrayExe"
        ExeCommand="--unregister-startup"
        Execute="immediate"
        Return="ignore"
        Impersonate="yes" />
    <!-- An uninstall also removes the user's database, logs, WebView2 profile and
         Credential Manager key; download folders in the profile survive unless empty.
         A major upgrade removes the old version the same way, so it is excluded: an
         upgrade keeps the user's settings and queue. -->
    <CustomAction
        Id="RemoveProfileOnUninstall"
        FileRef="WeaverTrayExe"
        ExeCommand="--uninstall-cleanup"
        Execute="immediate"
        Return="ignore"
        Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="StopTrayBeforeRemoval" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RemoveTrayStartupBeforeRemoval" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveProfileOnUninstall" After="StopTrayBeforeRemoval" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
