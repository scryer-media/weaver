    {
      "name": "enableLogin",
      "owner": "ui-security",
      "oracle": "browser"
    },
    {
      "name": "setAccessPolicy",
      "owner": "ui-security",
      "oracle": "unit-only",
      "rationale": "Loosening browser admission would sign the running Playwright session out of the very instance under test; the guard, environment-pinned refusal, strict-security refusal and no-login-while-login-enabled refusal are covered by weaver-server-api security_policy tests."
    },
    {
      "name": "setHttpBindAddress",
      "owner": "ui-security",
      "oracle": "unit-only",
      "rationale": "Changing the listen address only takes effect at the next restart, so a browser flow cannot observe its result within a test; the refusal paths (environment-pinned, strict-security without login) and the pending/restart reporting are covered by weaver-server-api security_policy tests and weaver-server-core security unit tests."
    },
