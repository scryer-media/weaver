  "mutations": [
    {
      "name": "resetServerDownloadQuotaUsage",
      "owner": "bandwidth-and-server-quotas",
      "oracle": "api-metrics"
    },
    {
      "name": "cancelJob",
      "owner": "duplicate-and-queue-policy",
      "oracle": "unit-only",
      "rationale": "Sanctioned setup helpers use this legacy alias only to seed history; cancelQueueItem owns the product assertion."
    },
    {
      "name": "cancelQueueItem",
      "owner": "duplicate-and-queue-policy",
      "oracle": "api-metrics"
    },
    {
      "name": "forgetDuplicateIdentity",
      "owner": "duplicate-and-queue-policy",
      "oracle": "unit-only",
      "rationale": "The release flow exercises duplicate decisions and good/bad replacement, not identity-forgetting administration."
    },
    {
      "name": "markDuplicateBad",
      "owner": "duplicate-and-queue-policy",
      "oracle": "api-metrics"
    },
    {
      "name": "markDuplicateGood",
      "owner": "duplicate-and-queue-policy",
      "oracle": "api-metrics"
    },
    {
      "name": "pauseAll",
      "owner": "duplicate-and-queue-policy",
      "oracle": "api-metrics"
    },
    {
      "name": "pauseJob",
      "owner": "duplicate-and-queue-policy",
      "oracle": "unit-only",
      "rationale": "The release flow owns the canonical pauseQueueItem behavior; this legacy job alias is not called."
    },
    {
      "name": "pauseQueue",
      "owner": "duplicate-and-queue-policy",
      "oracle": "unit-only",
      "rationale": "The release flow owns pauseAll and per-item pause behavior; this compatibility alias is not called."
    },
    {
      "name": "pauseQueueItem",
      "owner": "duplicate-and-queue-policy",
      "oracle": "api-metrics"
    },
    {
      "name": "promoteDuplicateCandidate",
      "owner": "duplicate-and-queue-policy",
      "oracle": "unit-only",
      "rationale": "The release flow proves automatic replacement through markDuplicateBad, not explicit candidate promotion."
    },
    {
      "name": "reorderQueueItem",
      "owner": "duplicate-and-queue-policy",
      "oracle": "api-metrics"
    },
    {
      "name": "resumeAll",
      "owner": "duplicate-and-queue-policy",
      "oracle": "api-metrics"
    },
    {
      "name": "resumeJob",
      "owner": "duplicate-and-queue-policy",
      "oracle": "unit-only",
      "rationale": "The release flow owns the canonical resumeQueueItem behavior; this legacy job alias is not called."
    },
    {
      "name": "resumeQueue",
      "owner": "duplicate-and-queue-policy",
      "oracle": "unit-only",
      "rationale": "The release flow owns resumeAll and per-item resume behavior; this compatibility alias is not called."
    },
