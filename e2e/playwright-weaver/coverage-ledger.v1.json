      "owner": "ui-post-processing",
      "oracle": "unit-only",
      "rationale": "Cancelling mid-script needs a job that is still executing; the browser flow asserts completed script results instead."
    },
    {
      "name": "reprocessJob",
      "owner": "ui-post-processing",
      "oracle": "unit-only",
      "rationale": "The browser flow exercises script reruns through rerunPostProcessing, not download-job reprocessing."
