{
  "name": "weaver-e2e-playwright",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:ui-settings-crud": "playwright test tests/ui-settings-crud.spec.ts",
    "test:ui-security": "playwright test tests/ui-security.spec.ts",
    "test:ui-ingress-automation": "playwright test tests/ui-ingress-automation.spec.ts",
    "test:ui-post-processing": "playwright test tests/ui-post-processing.spec.ts",
    "test:ui-runtime-observability": "playwright test tests/ui-runtime-observability.spec.ts",
    "test:ui-backup-restore": "playwright test tests/ui-backup-restore.spec.ts",
    "test:rate-limits": "playwright test tests/rate-limits.spec.ts",
    "test:bandwidth-and-server-quotas": "playwright test tests/bandwidth-and-server-quotas.spec.ts",
    "test:provider-connection-cap": "playwright test tests/provider-connection-cap.spec.ts",
    "test:proxy-routing": "playwright test tests/proxy-routing.spec.ts",
    "test:encryption-key-lifecycle": "playwright test tests/encryption-key-lifecycle.spec.ts",
    "test:duplicate-and-queue-policy": "playwright test tests/duplicate-and-queue-policy.spec.ts",
    "test:advanced-networking": "playwright test tests/network- --grep-invert \"@no-net-raw|@extended\"",
    "test:advanced-networking-restarted": "playwright test tests/network- --grep @restart --grep-invert \"@no-net-raw|@extended\"",
    "test:advanced-networking-no-net-raw": "playwright test tests/network-egress.spec.ts --grep @no-net-raw --grep-invert @extended",
    "test:advanced-networking-extended": "playwright test tests/network- --grep @extended",
    "test:event-scripts": "playwright test tests/event-scripts.spec.ts tests/scan-scripts.spec.ts tests/script-restart.spec.ts --grep-invert @extended",
    "test:post-processing-scripts": "playwright test tests/post-processing-scripts.spec.ts",
    "test:post-processing-scripts-restarted": "playwright test tests/post-processing-scripts.spec.ts --grep @restart",
    "test:scheduling":"playwright test tests/scheduling.spec.ts tests/auto-backup.spec.ts --grep-invert \"@dst|@extended\"",
    "test:scheduling-dst": "playwright test tests/auto-backup.spec.ts --grep @dst --grep-invert @extended",
    "test:two-nic": "playwright test tests/two-nic.spec.ts --grep-invert @extended",
    "audit": "npm run audit:self-containment && npm run audit:browser-boundary && npm run audit:selector-quality",
    "audit:self-containment": "node scripts/audit-self-containment.mjs",
    "audit:browser-boundary": "node scripts/audit-browser-boundary.mjs",
    "audit:selector-quality": "node scripts/audit-selector-quality.mjs",
    "test:audit-browser-boundary": "node --test scripts/browser-boundary.test.mjs",
    "test:audit-selector-quality": "node --test scripts/selector-quality.test.mjs",
    "test:proxy-fixture": "node --test scripts/proxy-fixture-server.test.mjs scripts/real-network-relay.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "playwright": "1.62.1",
    "typescript": "7.0.2"
  }
}
