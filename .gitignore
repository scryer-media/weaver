# Build artifacts
/target
**/target
# Sanitizer builds use a separate target dir so instrumented artifacts never
# mix with (or invalidate) the release/bench caches.
/target-asan
**/*.rs.bk
*.so
*.dylib
*.dll

# IDE
.idea
.vscode
*.swp
*~

# OS
.DS_Store

# Environment / secrets
**/*.env
/.env
*.pem

# Database
*.db
*.db-shm
*.db-wal

# Logs
*.log

# Internal
.claude
.github/copilot-instructions.md
tasks/
tmp/
weaver.toml
weaver.toml.*
docker-rar/
.7z-version
AUDIT-*.md

# Frontend
apps/weaver-web/node_modules
apps/weaver-web/dist
apps/weaver-web/.vite

# Local agent skills (machine-specific only)
.agents/skills/claude-context/

# Benchmark snapshots are local artifacts. Keep scripts and harnesses tracked,
# but do not commit generated measurements.
ci/bench/results/**
