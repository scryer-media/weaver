{
  "schema_version": 2,
  "adapters": [
    {
      "client": "weaver",
      "target": "macos-native",
      "command": ["/scratch/nntp-bench-bin/nativeadapter"],
      "environment": {
        "NATIVE_CLIENT_VERSION": "REPLACE_WITH_WEAVER_VERSION",
        "NATIVE_LAUNCH_COMMAND": "[\"/absolute/path/to/weaver\",\"--config\",\"{{config_dir}}\",\"download\",\"{{nzb_path}}\"]"
      }
    },
    {
      "client": "sabnzbd",
      "target": "macos-native",
      "command": ["/scratch/nntp-bench-bin/nativeadapter"],
      "environment": {
        "NATIVE_CLIENT_VERSION": "5.0.4",
        "NATIVE_API_ENDPOINT": "http://127.0.0.1:18080",
        "NATIVE_LAUNCH_COMMAND": "[\"/Applications/SABnzbd.app/Contents/MacOS/SABnzbd\",\"--config-file\",\"{{config_dir}}/sabnzbd.ini\",\"--server\",\"127.0.0.1:18080\",\"--browser\",\"0\",\"--console\",\"--new\"]"
      }
    },
    {
      "client": "nzbget",
      "target": "macos-native",
      "command": ["/scratch/nntp-bench-bin/nativeadapter"],
      "environment": {
        "NATIVE_CLIENT_VERSION": "REPLACE_WITH_NZBGET_VERSION",
        "NATIVE_API_ENDPOINT": "http://127.0.0.1:16789",
        "NATIVE_LAUNCH_COMMAND": "[\"/absolute/path/to/nzbget\",\"-c\",\"{{config_dir}}/nzbget.conf\",\"-s\"]"
      }
    }
  ]
}
