{
  "schema_version": 4,
  "adapters": [
    {
      "client": "weaver",
      "archive_toolchain": "vanilla",
      "target": "windows-native",
      "command": ["C:\\bench\\bin\\nativeadapter.exe"],
      "environment": {
        "NATIVE_CLIENT_VERSION": "REPLACE_WITH_WEAVER_VERSION",
        "NATIVE_API_ENDPOINT": "http://127.0.0.1:19090",
        "NATIVE_LAUNCH_COMMAND": "[\"C:\\\\path\\\\to\\\\weaver.exe\",\"--config\",\"{{config_dir}}\",\"serve\",\"--port\",\"{{api_port}}\"]"
      }
    },
    {
      "client": "sabnzbd",
      "archive_toolchain": "vanilla",
      "target": "windows-native",
      "command": ["C:\\bench\\bin\\nativeadapter.exe"],
      "environment": {
        "NATIVE_CLIENT_VERSION": "REPLACE_WITH_SABNZBD_VERSION",
        "NATIVE_API_ENDPOINT": "http://127.0.0.1:18080",
        "NATIVE_LAUNCH_COMMAND": "[\"C:\\\\path\\\\to\\\\SABnzbd-console.exe\",\"--config-file\",\"{{config_dir}}\\\\sabnzbd.ini\",\"--server\",\"127.0.0.1:18080\",\"--browser\",\"0\",\"--console\",\"--new\"]"
      }
    },
    {
      "client": "nzbget",
      "archive_toolchain": "vanilla",
      "target": "windows-native",
      "command": ["C:\\bench\\bin\\nativeadapter.exe"],
      "environment": {
        "NATIVE_CLIENT_VERSION": "REPLACE_WITH_NZBGET_VERSION",
        "NATIVE_API_ENDPOINT": "http://127.0.0.1:16789",
        "NATIVE_LAUNCH_COMMAND": "[\"C:\\\\path\\\\to\\\\nzbget.exe\",\"-c\",\"{{config_dir}}\\\\nzbget.conf\",\"-s\"]"
      }
    }
  ]
}
